# Скопируйте в .env и заполните при необходимости.
# Прокси (опционально). Применяется и к HTTP, и к HTTPS (Авито работает по HTTPS).
# Если пусто — запросы идут напрямую.
# Пример: http://user:pass@host:port  или  socks5://user:pass@host:port (нужен httpx[socks])
AVITO_PROXY=
# Раздельно (если нужно по-разному); используется, только если AVITO_PROXY пуст:
AVITO_PROXY_HTTP=
AVITO_PROXY_HTTPS=

# Задержки между запросами (секунды). Случайная пауза в [MIN, MAX] + небольшой джиттер.
AVITO_DELAY_MIN=5
AVITO_DELAY_MAX=10

# Таймаут запроса (секунды) и число повторов при сетевых ошибках.
AVITO_TIMEOUT=60
AVITO_RETRIES=2

# При блокировке (429/403/302): ждать N секунд и повторить.
AVITO_BLOCK_COOLDOWN=60
AVITO_BLOCK_MAX_RETRIES=3

# URL принудительной смены IP у провайдера (дёргается при блоке, напрямую мимо прокси).
# Если задан — с ним cooldown можно ставить меньше (напр. 10-15 сек).
# Пример (mobileproxy.space): https://changeip.mobileproxy.space/?proxy_key=...&format=json
AVITO_ROTATE_IP_URL=
# Сколько ждать, если провайдер не смог сменить IP (ждём авто-ротацию, обычно ~2 мин).
AVITO_ROTATE_FAIL_WAIT=130

# User-Agent для запросов.
AVITO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
